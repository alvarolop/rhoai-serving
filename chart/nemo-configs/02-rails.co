# ============================================================
# BOT RESPONSES
# ============================================================

define bot inform message too long
  "Your message is too long. Please keep messages under 2000 characters."

define bot refuse jailbreak attempt
  "I cannot process this request as it appears to be an attempt to bypass my safety guidelines. Please ask a legitimate question."

define bot refuse malicious script request
  "I cannot provide scripts or code that could be used maliciously. Please ask for legitimate programming help instead."

define bot refuse script output
  "I apologize, but I cannot provide this response as it contains script content that could be unsafe. Please rephrase your question."

define bot inform output too long
  "I apologize, my response was too long. Let me summarize more concisely."

