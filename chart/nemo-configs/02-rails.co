# ============================================================
# CORE GUARDRAILS (Active by default in values.yaml)
# ============================================================
# Three-layer defense:
#   1. Jailbreak detection - Block prompt injection attempts
#   2. Script blocking - Prevent malicious code generation requests
#   3. PII detection - Presidio-based sensitive data masking
# ============================================================

# 1. JAILBREAK DETECTION (Keyword-based pattern matching)
define flow check jailbreak
  $allowed = execute check_jailbreak
  if not $allowed
    bot refuse jailbreak attempt
    stop

# 2. MALICIOUS SCRIPT BLOCKING
define flow check malicious scripts
  $allowed = execute check_malicious_script_request
  if not $allowed
    bot refuse malicious script request
    stop

define flow check script in output
  $allowed = execute check_script_output
  if not $allowed
    bot refuse script output
    stop

# 3. PII DETECTION (Presidio)
# Built-in NeMo flows - automatically available when sensitive_data_detection is configured
# Flows: 'mask sensitive data on input', 'mask sensitive data on output'
# Configuration: See values.yaml guardrails.config.sensitive_data_detection

# ============================================================
# UTILITY FLOWS
# ============================================================

# Message length validation (deterministic)
define flow check message length
  if len($user_message) > 2000
    bot inform message too long
    stop


# ============================================================
# BOT RESPONSES
# ============================================================

define bot inform message too long
  "Your message is too long. Please keep messages under 2000 characters."

define bot refuse jailbreak attempt
  "I cannot process this request as it appears to be an attempt to bypass my safety guidelines. Please ask a legitimate question."

define bot refuse malicious script request
  "I cannot provide scripts or code that could be used maliciously. Please ask for legitimate programming help instead."

define bot refuse script output
  "I apologize, but I cannot provide this response as it contains script content that could be unsafe. Please rephrase your question."
