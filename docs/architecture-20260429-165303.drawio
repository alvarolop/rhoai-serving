        <mxCell id="llmisvc" value="LLMInferenceService&#xa;(Generative)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#70ad47;strokeWidth=1;" vertex="1" parent="serving-layer">
