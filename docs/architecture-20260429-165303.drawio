          <mxGeometry x="130" y="80" width="800" height="700" as="geometry"/>
        </mxCell>

        <!-- Sub-container: Model Serving Layer -->
        <mxCell id="serving-layer" value="Model Serving (KServe Raw Mode)" style="swimlane;whiteSpace=wrap;html=1;rounded=1;strokeColor=#4472c4;strokeWidth=2;fillColor=#dae8fc;fontStyle=1;fontSize=12;startSize=30;" vertex="1" parent="platform">
          <mxGeometry x="30" y="60" width="360" height="300" as="geometry"/>
