        <mxCell id="llmd" value="llm-d Router&#xa;(Inference Accel.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8c4f0;strokeColor=#7f7fff;strokeWidth=2;" vertex="1" parent="serving-layer">
