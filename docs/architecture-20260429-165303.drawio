<mxfile host="app.diagrams.net">
  <diagram id="rhoai-serving-arch" name="RHOAI Serving Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- User/Admin Actors -->
        <mxCell id="user-1" value="User" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="30" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="admin-1" value="Admin" style="shape=umlActor;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="30" height="60" as="geometry"/>
        </mxCell>

        <!-- Main Container: Red Hat OpenShift AI Platform -->
