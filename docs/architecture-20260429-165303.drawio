          <mxGeometry x="20" y="50" width="50" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="kserve" value="KServe&#xa;Orchestrator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4472c4;strokeWidth=2;fontStyle=1;" vertex="1" parent="serving-layer">
          <mxGeometry x="80" y="50" width="100" height="60" as="geometry"/>
