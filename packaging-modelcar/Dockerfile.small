# ModelCar for SMALL models whose weights are NOT (only) safetensors, e.g. BAAI/bge-m3 (pytorch_model.bin).
# Everything goes into ONE layer, so use it only for models that fit comfortably in a single layer
# (a few GB; Quay rejects layers over 20 GB). For big models use packaging-modelcar/Dockerfile.
#
#   podman build --platform linux/amd64 -f packaging-modelcar/Dockerfile.small packaging-modelcar \
#     --build-arg MODEL_REPO=BAAI/bge-m3 --secret id=hf,src=.hf_token \
#     -t quay.io/<org>/modelcar-bge-m3:latest
#
# vLLM loads pytorch_model.bin / *.pt when there are no safetensors (--load-format auto).
# Override what is downloaded with --build-arg HF_ALLOW_PATTERNS=... / HF_IGNORE_PATTERNS=...

ARG MODEL_REPO=BAAI/bge-m3

FROM registry.access.redhat.com/ubi9/python-314:latest AS downloader
ARG MODEL_REPO
ARG HF_TOKEN=""
# Weights (safetensors, bin, pt), configs, tokenizers and chat templates. Skip onnx/ and images.
ARG HF_ALLOW_PATTERNS="*.safetensors,*.bin,*.pt,*.json,*.txt,*.model,*.jinja"
ARG HF_IGNORE_PATTERNS="onnx/*,imgs/*,*.onnx*,consolidated*.safetensors"

USER root
RUN pip install --no-cache-dir "huggingface_hub>=0.24.0"

ENV MODEL_REPO=${MODEL_REPO}
ENV HF_TOKEN=${HF_TOKEN}
ENV HF_ALLOW_PATTERNS=${HF_ALLOW_PATTERNS}
ENV HF_IGNORE_PATTERNS=${HF_IGNORE_PATTERNS}

COPY download_model.py /tmp/download_model.py

# Hugging Face token as a build secret (never stored in a layer): --secret id=hf,src=.hf_token
RUN --mount=type=secret,id=hf,required=false \
    set -ex; \
    if [ -s /run/secrets/hf ]; then export HF_TOKEN="$(cat /run/secrets/hf)"; fi; \
    python /tmp/download_model.py; \
    rm -rf /models/.cache /tmp/download_model.py; \
    # Read-only: vLLM only reads the model
    find /models -type f -exec chmod 0444 {} +; \
    find /models -type d -exec chmod 0555 {} +

# Runtime image: the whole model in a single layer on top of UBI Micro
FROM registry.access.redhat.com/ubi9/ubi-micro:latest
COPY --from=downloader --chown=1001:0 /models/ /models/
RUN chmod 555 /models
USER 1001
